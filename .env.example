# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (Vercel)
# ─────────────────────────────────────────────────────────────────────────────
# In Vercel, set VITE_API_URL to your deployed Render backend URL:
# e.g. VITE_API_URL=https://nutricraft-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND CONFIGURATION (Render / Local)
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Firebase Configuration (Firebase Realtime Database & Firebase Auth)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini AI API Key (AI Food Vision & Nutrition Chatbot)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional USDA FoodData Central API (Fallback Database for Food Search)
USDA_FDC_API_KEY=your_usda_api_key_here

# TheMealDB API Configuration (Food Blogs & Recipes)
THEMEALDB_API_KEY=1
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1

# JWT Session Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
